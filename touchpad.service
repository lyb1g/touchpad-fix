[Unit]
Description=Touchpad Python service
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/run/media/dimon/Dimon/Python/touchpad
ExecStart=/run/media/dimon/Dimon/Python/touchpad/venv/bin/python /run/media/dimon/Dimon/Python/touchpad/touchpad_click.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
